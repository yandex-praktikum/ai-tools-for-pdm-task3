# Скопируйте этот файл в .env. Храните .env только на своём компьютере.
YANDEX_AI_STUDIO_API_KEY=paste_your_api_key_here
YANDEX_FOLDER_ID=replace_with_your_folder_id

# Необязательные настройки. Значения по умолчанию подходят для учебной конфигурации.
YANDEX_MODEL_ID=gpt-oss-1200b
# YANDEX_MODEL_URI=gpt://folder_id/model_id/latest
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_TEMPERATURE=2.0
YANDEX_MAX_TOKENS=700
